# ---- ClipCrest settings. Copy this file to .env and fill it in. Never commit .env. ----
#
# On your own computer you need nothing here: start ClipCrest, open it, and add your AI key under Settings, AI.
# This file is for servers, and for anyone who prefers to keep settings in a file.

# ================================================================ AI: bring your own key
# The easy way is the dashboard: Settings, AI. Whatever is saved there is used instead of these lines.
# ClipCrest uses an AI model to pick the moments worth clipping and to write hooks, titles and captions.
# You choose the service and pay that service directly; ClipCrest adds nothing on top.
# Without a key ClipCrest still works: clips are then picked by loudness only, with no titles.
#
#   provider     where to get a key                          example model ids (check the provider's current list)
#   gemini       https://aistudio.google.com/apikey           gemini-2.5-flash
#   openai       https://platform.openai.com/api-keys         gpt-4o-mini
#   xai          https://console.x.ai                         grok-4            (Grok)
#   groq         https://console.groq.com/keys                llama-3.3-70b-versatile
#   openrouter   https://openrouter.ai/keys                   any model id listed there
#   anthropic    https://console.anthropic.com                a current Claude model id
#   ollama       no key: a model running on this machine      llama3.1          (ollama pull llama3.1)
#   custom       any service that speaks the OpenAI chat format: also set CLIPCREST_AI_BASE_URL
CLIPCREST_AI_PROVIDER=gemini
CLIPCREST_AI_MODELS=
CLIPCREST_AI_KEY=
# CLIPCREST_AI_KEY_FILE=/secrets/ai.txt        # instead of CLIPCREST_AI_KEY: a file that holds the key
# CLIPCREST_AI_BASE_URL=                       # only for "custom", e.g. http://127.0.0.1:1234/v1
# CLIPCREST_AI_MODELS takes several ids separated by commas. They are tried in order, so the second is a fallback.

# ================================================================ on a server (Docker)
# Your domain (DNS must already point at this server) and a database password you make up.
# CLIPCREST_DOMAIN=clipcrest.example.com
# POSTGRES_PASSWORD=change-me-to-a-long-random-string

# A server ClipCrest has to itself: keep this line, and ClipCrest fetches its own HTTPS certificate.
# A server that already runs a web server for other sites: leave it out and see deploy/nginx-clipcrest.conf.
# COMPOSE_PROFILES=own-https
# Behind Cloudflare's CDN: put the Cloudflare origin certificate in ./secrets as cloudflare-origin.crt and
# cloudflare-origin.key, and use the Caddyfile that serves it.
# CLIPCREST_CADDYFILE=Caddyfile.origin
# CLIPCREST_BIND_PORT=8765           # the port ClipCrest listens on inside the server, if 8765 is taken
# Behind a Traefik that is already on the server, use this instead of the own-https line:
# COMPOSE_FILE=docker-compose.yml:deploy/docker-compose.traefik.yml
# If the domain goes through Cloudflare's CDN (orange cloud), the visitor's real address comes in this header.
# It is only believed for connections that really come from Cloudflare.
# CLIPCREST_CLIENT_IP_HEADER=CF-Connecting-IP

# On a server shared with other apps: keep ClipCrest inside its own share.
# CLIPCREST_MEM_LIMIT=2g             # most memory it may use (it is stopped, not the other apps, if it goes over)
# CLIPCREST_CPUS=1.5                 # most processor cores it may use
# CLIPCREST_CPU_SHARES=256           # its turn at the processor when the server is busy (1024 is normal)
# CLIPCREST_OOM_SCORE_ADJ=900        # if the whole server runs out of memory, ClipCrest is stopped first
# CLIPCREST_DB_MEM_LIMIT=256m

# ================================================================ where things are kept (own computer)
# CLIPCREST_DATA=./data              # videos, clips, the database file and the speech model
# CLIPCREST_PORT=8765
# CLIPCREST_PUBLIC_URL=http://127.0.0.1:8765     # the address people open; set it to https://your-domain on a server
# DATABASE_URL=                    # empty: a SQLite file in the data folder. Or postgresql+psycopg://user:pass@host/db

# ================================================================ sign-in
# Off by default: ClipCrest opens straight into the dashboard, which is right for your own computer.
# On a server other people can reach, turn accounts on, or anyone who finds the address can use it and your AI key.
# (docker-compose.yml turns them on by itself.)
# CLIPCREST_ACCOUNTS=1

# ================================================================ admins (only with accounts on)
# Admins are not set here. Every new account is a normal user. After you sign up, make yourself an admin:
#   python -m studio.admin grant you@example.com                 (also: revoke, list)
#   docker compose exec app python -m studio.admin grant you@example.com      (with Docker)
# The admin dashboard is then at /admin, and does not exist for anyone else.

# ================================================================ Google (optional)
# One "Web application" OAuth client, used for Sign in with Google and for connecting YouTube to post Shorts.
# Authorised redirect URIs:  https://YOUR-DOMAIN/auth/google/callback  and  https://YOUR-DOMAIN/oauth/youtube/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CLIENT_FILE=/secrets/google_client.json

# Instagram and TikTok: the apps people's accounts connect through (Connect buttons in Settings, Connected apps).
# These can also be pasted in the dashboard by an admin: Settings, Connected apps, Set up. Redirect addresses to
# register:  https://YOUR-DOMAIN/oauth/instagram/callback  and  https://YOUR-DOMAIN/oauth/tiktok/callback
# CLIPCREST_IG_APP_ID=
# CLIPCREST_IG_APP_SECRET=
# CLIPCREST_TIKTOK_CLIENT_KEY=
# CLIPCREST_TIKTOK_CLIENT_SECRET=

# ================================================================ email (optional)
# Any SMTP service. Without it, password-reset and confirmation links are printed in the server's output instead,
# which is enough on your own computer.
# CLIPCREST_SMTP_HOST=
# CLIPCREST_SMTP_PORT=587
# CLIPCREST_SMTP_USER=
# CLIPCREST_SMTP_PASSWORD=
# CLIPCREST_SMTP_PASSWORD_FILE=/secrets/smtp.txt
# CLIPCREST_MAIL_FROM=ClipCrest <hello@your-domain.com>
# CLIPCREST_VERIFY_EMAIL=1           # on a public site: people must confirm their email before clipping
# Some hosts (DigitalOcean, for one) block the mail ports on new servers. Brevo's web API sends over HTTPS instead,
# which no host blocks. With its key set it is used instead of SMTP (CLIPCREST_MAIL_FROM is still needed).
# CLIPCREST_BREVO_API_KEY=xkeysib-...
# CLIPCREST_BREVO_API_KEY_FILE=/secrets/brevo.txt   # instead of CLIPCREST_BREVO_API_KEY: a file that holds the key

# Shown on the privacy, terms and acceptable-use pages of a public site.
# CLIPCREST_CONTACT_EMAIL=
# CLIPCREST_LEGAL_NAME=
# CLIPCREST_LEGAL_COUNTRY=

# ================================================================ limits (all optional)
# How many videos run at once is decided by how busy the machine really is, every second. These only set the edges:
# CLIPCREST_JOB_WORKERS=8            # the most videos that may ever run at once (default: one per CPU core)
# CLIPCREST_BUSY_CPU=82              # no extra video or recording starts while the processor is above this percent
# CLIPCREST_MIN_FREE_RAM_GB=1.5      # ...or while less memory than this is free
# There are no limits unless you set one here: 0 (the default) means none. A server other people use may want some.
# CLIPCREST_MAX_LIVE=8               # live recordings at once, whole server (default: twice the CPU cores; load decides below it)
# CLIPCREST_MAX_LIVE_PER_USER=0      # streams one person records at once
# CLIPCREST_MAX_JOBS_PER_USER=5      # videos one person sends and has worked on at once
# CLIPCREST_MAX_UPLOAD_MB=0          # the largest video file someone may upload
# CLIPCREST_UPLOAD_PART_MB=40        # big files are sent in pieces of this size (Cloudflare refuses requests over 100 MB)
# CLIPCREST_MAX_VIDEO_HOURS=0        # longest video, or chosen part of one, that is processed
# CLIPCREST_MAX_LIVE_HOURS=0         # a live recording stops by itself after this long
# CLIPCREST_MAX_USER_GB=0            # disk space one account may use
# CLIPCREST_MAX_CREATORS=0           # creators one account may add
# CLIPCREST_FFMPEG_DIR=              # the folder that holds ffmpeg, if ClipCrest cannot find it by itself
# CLIPCREST_CLIP_MINUTES=15          # a clip that takes longer than this to make is stopped, so it cannot hold the video up
# CLIPCREST_ALLOWED_SITES=youtube.com,youtu.be,twitch.tv,kick.com
# CLIPCREST_YT_TRANSCRIPT=1          # use YouTube's own transcript to find clips faster (0: always transcribe here)
# CLIPCREST_UPDATE_CHECK=1          # look on GitHub once a minute for a newer ClipCrest (0: never)
# CLIPCREST_UPDATE_REPO=Ahmed-Islam-AI/clipcrest   # where to look for a newer version (a fork points at itself)

# ================================================================ links in the dashboard (all optional)
# These are the defaults. A fork or a public site can point them elsewhere.
# CLIPCREST_REPO_URL=https://github.com/Ahmed-Islam-AI/clipcrest           # the project's code (feedback goes to its issues page)
# CLIPCREST_FOLLOW_URL=https://www.linkedin.com/in/ahmed-islam-ai/         # where to follow the maker
# CLIPCREST_DOWNLOAD_URL=https://github.com/Ahmed-Islam-AI/clipcrest/releases/latest   # where every "Download" button goes

# ================================================================ speech to text on a graphics card (optional)
# Speech is transcribed on this machine's processor by default. A second machine with an NVIDIA card can take
# over most of it: see deploy/gpu/docker-compose.yml, then set these on the main server.
# CLIPCREST_ASR_URL=http://10.0.0.2:9000
# CLIPCREST_ASR_TOKEN=a-long-random-string-shared-by-both-machines

# ================================================================ Earn: paid clipping campaigns (/earn)
# Campaigns are created at /admin/earn. With a YouTube Data API v3 key, every YouTube Short sent to a campaign is
# checked automatically (whose channel, when it was posted, the caption tag) and its views refresh every few hours.
# Without one, YouTube views are typed in by hand like Instagram and X. You can also paste the key in
# /admin/earn/settings instead.
# CLIPCREST_YOUTUBE_API_KEY=

# ================================================================ behind a Cloudflare Tunnel (cloudflared)
# Every visitor then reaches ClipCrest from this machine itself. These two lines make sign-up and login limits
# count each real visitor, instead of everyone sharing one address (which would block sign-ups after a few people).
# CLIPCREST_TUNNEL=1
# CLIPCREST_CLIENT_IP_HEADER=CF-Connecting-IP

# ================================================================ a public Earn website (optional)
# On your own computer (no sign-in) Earn stays hidden unless CLIPCREST_EARN_URL is set. Set it to the public Earn
# website, and the app's Earn button sends people there. Empty (the default): no Earn button.
# CLIPCREST_EARN_URL=https://earn.your-domain.com
# On that public website itself: Earn on, clip-making off for everyone but admins (people make clips with the download).
# CLIPCREST_EARN_ONLY=1
